Questions and Solutions:

-- Q-1. Write an SQL query to fetch “FIRST_NAME” from Worker table using the alias name as <WORKER_NAME>.

SOL: SELECT FIRST_NAME AS WORKER_NAME 
FROM Worker 
GROUP BY FIRST_NAME;


-- Q-2. Write an SQL query to fetch “FIRST_NAME” from Worker table in upper case.

SOL: SELECT UPPER(FIRST_NAME) 
FROM Worker 
GROUP BY FIRST_NAME;


-- Q-3. Write an SQL query to fetch unique values of DEPARTMENT from Worker table.

SOL: SELECT distinct department from worker;
or
SELECT DEPARTMENT 
FROM Worker 
GROUP BY DEPARTMENT;


-- Q-4. Write an SQL query to print the first three characters of  FIRST_NAME from Worker table.

sol: SELECT SUBSTRING(FIRST_NAME, 1, 3) 
FROM Worker 
GROUP BY FIRST_NAME;


-- Q-5. Write an SQL query to find the position of the alphabet (‘b’) in the first name column ‘Amitabh’ from Worker table.

sol: SELECT INSTR(FIRST_NAME, 'B') 
FROM Worker 
WHERE FIRST_NAME = 'Amitabh' 
GROUP BY FIRST_NAME;


-- Q-6. Write an SQL query to print the FIRST_NAME from Worker table after removing white spaces from the right side.

sol: SELECT RTRIM(FIRST_NAME) 
FROM Worker 
GROUP BY FIRST_NAME;


-- Q-7. Write an SQL query to print the DEPARTMENT from Worker table after removing white spaces from the left side.

sol: SELECT LTRIM(FIRST_NAME) 
FROM Worker 
GROUP BY FIRST_NAME;


-- Q-8. Write an SQL query that fetches the unique values of DEPARTMENT from Worker table and prints its length.

sol: SELECT DEPARTMENT, LENGTH(DEPARTMENT) 
FROM Worker 
GROUP BY DEPARTMENT;


-- Q-9. Write an SQL query to print the FIRST_NAME from Worker table after replacing ‘a’ with ‘A’.

sol: SELECT REPLACE(FIRST_NAME, 'a', 'A') 
FROM Worker 
GROUP BY FIRST_NAME;


-- Q-10. Write an SQL query to print the FIRST_NAME and LAST_NAME from Worker table into a single column COMPLETE_NAME.

sol: SELECT CONCAT(FIRST_NAME, ' ', LAST_NAME) AS COMPLETE_NAME 
FROM Worker 
GROUP BY FIRST_NAME, LAST_NAME;


-- Q-11. Write an SQL query to print all Worker details from the Worker table order by FIRST_NAME Ascending.

sol: SELECT * 
FROM Worker 
GROUP BY WORKER_ID 
ORDER BY FIRST_NAME ASC;


-- Q-12. Write an SQL query to print all Worker details from the Worker table order by 
-- FIRST_NAME Ascending and DEPARTMENT Descending.

sol: SELECT * 
FROM Worker 
GROUP BY WORKER_ID 
ORDER BY FIRST_NAME ASC, DEPARTMENT DESC;


